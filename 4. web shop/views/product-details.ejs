<!DOCTYPE html>
<html lang="en">
  <% locals.pageStyles.push("/styles/pages/productDetails.css") %> <%-
  include('./shared/head.ejs') %>
  <body>
    <%- include('./shared/header.ejs') %>
    <section>
      <div class="container-div">
        <div class="product_div">
          <!-- Left Side: Product Image -->
          <div class="product-media_div">
            <img
              src="<%= productDetails.imagePath %>"
              class="product-image_img"
            />
          </div>

          <!-- Right Side: Product Information -->
          <div class="product-content_div">
            <h1 class="product-title_h1"><%= productDetails.name %></h1>

            <!-- Price Section -->
            <div class="product-price-container_div">
              <p class="product-price-label_p">Price</p>
              <span class="product-price_span"
                ><%= productDetails.price %> €</span
              >
            </div>

            <!-- Stock Status -->
            <div class="product-stock-container_div">
              <span class="product-stock-label_span">Availability</span>
              <div class="product-stock-badge_div">
                <svg
                  class="product-stock-icon_svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="product-stock-status_span">In Stock</span>
              </div>
            </div>

            <!-- Description -->
            <div class="product-description-container_div">
              <h2 class="product-description-heading_h2">Description</h2>
              <p class="product-description_p">
                <%= productDetails.description %>
              </p>
            </div>

            <!-- Actions Section -->
            <div class="product-actions_div">
              <form
                action="/product/add-to-cart"
                method="post"
                class="add-to-cart-form"
              >
                <div>
                  <input
                    type="number"
                    name="quantity"
                    id="quantity"
                    min="1"
                    value="1"
                    class="form-input"
                  />
                  <input
                    type="hidden"
                    name="id"
                    value="<%= locals.productDetails.id  %>"
                  />
                  <label class="quantity-label-span" for="quantity"
                    >Količina</label
                  >
                </div>
                <button type="submit" class="add-to-cart_button">
                  <img
                    src="assets/cart icon white.png"
                    alt=""
                    class="add-to-cart-img"
                  />
                  <span>U košaricu</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
    <%- include('./shared/footer.ejs') %>
  </body>
</html>
